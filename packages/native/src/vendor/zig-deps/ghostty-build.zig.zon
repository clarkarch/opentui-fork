.{
    .name = .ghostty,
    .version = "1.3.2-dev",
    .paths = .{""},
    .fingerprint = 0x64407a2a0b4147e5,
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        .uucode = .{
            .path = "../uucode-ghostty",
        },
        .apple_sdk = .{ .path = "./pkg/apple-sdk" },
        .android_ndk = .{ .path = "./pkg/android-ndk" },
        // tfm fork: the embedded terminal renders Kitty images, so the VT
        // build keeps the Kitty graphics protocol enabled -- and Ghostty
        // requires a `wuffs` module for it. This is the fork's own pure Zig
        // package (see zig-deps/wuffs/), not Ghostty's C-translated one.
        .wuffs = .{
            .path = "../wuffs",
        },
    },
}
